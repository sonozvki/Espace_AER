datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  role         Role     @default(ADMIN)
  epitechToken String?  // Cookie "user" de intra.epitech.eu, chiffré (AES-256-GCM)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guardsOnDuty    Guard[]  @relation("GuardDuty")
  guardAbsences   Guard[]  @relation("GuardAbsences")
  swapRequests    GuardSwapRequest[] @relation("requester")
  swapAcceptances GuardSwapRequest[] @relation("accepter")
  auditLogs       AuditLog[]
}

model Whitelist {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  role      Role
  createdAt DateTime @default(now())
}

model Memo {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([createdAt(sort: Desc)])
}

model Guard {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // AER de garde ce jour
  guardAer   User? @relation("GuardDuty", fields: [guardAerId], references: [id])
  guardAerId Int?

  // AERs absents ce jour (many-to-many implicite)
  absentAers User[] @relation("GuardAbsences")

  // Métadonnées calendaires (renseignées à la génération)
  isPublicHoliday   Boolean @default(false)
  publicHolidayName String?
  isSchoolHoliday   Boolean @default(false)
  schoolHolidayName String?

  swapRequests GuardSwapRequest[] @relation("source")
  swapTargets  GuardSwapRequest[] @relation("target")

  @@unique([date])
  @@index([date])
}

model GuardSwapRequest {
  id        Int        @id @default(autoincrement())
  status    SwapStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  requester   User  @relation("requester", fields: [requesterId], references: [id])
  requesterId Int
  accepter    User? @relation("accepter", fields: [accepterId], references: [id])
  accepterId  Int?
  sourceGuard   Guard @relation("source", fields: [sourceGuardId], references: [id])
  sourceGuardId Int
  targetGuard   Guard @relation("target", fields: [targetGuardId], references: [id])
  targetGuardId Int

  @@index([requesterId])
  @@index([status])
}

enum SwapStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  user   User @relation(fields: [userId], references: [id])
  userId Int
  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model Resource {
  id          Int      @id @default(autoincrement())
  title       String
  url         String
  description String   @default("")
  category    String   @default("Divers")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

