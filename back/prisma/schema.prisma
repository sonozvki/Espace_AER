datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  role         Role     @default(ADMIN)
  epitechToken String?  // Cookie "user" de intra.epitech.eu, chiffré (AES-256-GCM)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guardsOnDuty          Guard[]  @relation("GuardDuty")
  guardAbsences         Guard[]  @relation("GuardAbsences")
  guardUnavailabilities Guard[]  @relation("GuardUnavailabilities")
  auditLogs             AuditLog[]
}

model Whitelist {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  role      Role
  createdAt DateTime @default(now())
}

model Memo {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([createdAt(sort: Desc)])
}

model Guard {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardAer   User? @relation("GuardDuty", fields: [guardAerId], references: [id])
  guardAerId Int?

  absentAers      User[] @relation("GuardAbsences")
  unavailableAers User[] @relation("GuardUnavailabilities")

  isPublicHoliday   Boolean @default(false)
  publicHolidayName String?
  isSchoolHoliday   Boolean @default(false)
  schoolHolidayName String?

  @@unique([date])
  @@index([date])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  user   User @relation(fields: [userId], references: [id])
  userId Int
  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model Resource {
  id          Int      @id @default(autoincrement())
  title       String
  url         String
  description String   @default("")
  category    String   @default("Divers")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

