datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  role         Role     @default(ADMIN)
  epitechToken   String?  // Cookie "user" de intra.epitech.eu, chiffré (AES-256-GCM)
  // Génération AER : année scolaire où l'AER a commencé (2026 = 2026-2027).
  // Seules les AER_GENERATIONS générations les plus récentes sont actives (FIFO).
  aerSince     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guardsOnDuty          Guard[]  @relation("GuardDuty")
  guardAbsences         Guard[]  @relation("GuardAbsences")
  guardUnavailabilities Guard[]  @relation("GuardUnavailabilities")
  auditLogs             AuditLog[]
}

model Whitelist {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  role      Role
  createdAt DateTime @default(now())
}

model Memo {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([createdAt(sort: Desc)])
}

model Guard {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardAer   User? @relation("GuardDuty", fields: [guardAerId], references: [id])
  guardAerId Int?

  absentAers      User[] @relation("GuardAbsences")
  unavailableAers User[] @relation("GuardUnavailabilities")

  isPublicHoliday   Boolean @default(false)
  publicHolidayName String?
  isSchoolHoliday   Boolean @default(false)
  schoolHolidayName String?

  @@unique([date])
  @@index([date])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  user   User @relation(fields: [userId], references: [id])
  userId Int
  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model Resource {
  id          Int      @id @default(autoincrement())
  title       String
  url         String? // null pour les ressources de type fichier
  description String   @default("")
  category    String   @default("Divers")
  fileName    String? // renseignés uniquement pour les ressources de type fichier (PDF)
  fileMime    String?
  fileSize    Int?
  fileData    Bytes?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Années scolaires. La plus récente est l'année courante ; sa startDate borne les stats.
model SchoolYear {
  year      Int      @id // 2026 = année 2026-2027
  startDate DateTime @db.Date
  createdAt DateTime @default(now())
}

model StudentCache {
  id           Int      @id @default(autoincrement())
  login        String
  promo        String
  location     String
  firstName    String
  lastName     String
  semester     Int?
  gpa          Float?
  credits      Int?
  netsoulHours Int?
  syncedAt     DateTime @default(now())

  @@unique([login, promo, location])
  @@index([promo, location])
}

