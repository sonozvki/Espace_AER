# Copier en .env.prod et remplir les valeurs avant de déployer
# NE JAMAIS committer .env.prod
# Usage : docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# DATABASE_URL est construit automatiquement par docker-compose (postgresql://postgres:<DB_PASSWORD>@db:5432/aer_prod)
DB_PASSWORD=change_me_strong_password

# Générer avec : openssl rand -hex 32
JWT_SECRET=change_me_64_chars_minimum
# Doit faire exactement 32 caractères (AES-256-GCM)
ENCRYPTION_KEY=change_me_32_chars_exactly!!!!!!

FRONTEND_URL=https://espace-aer.nice-tek.eu
# Injectée au build Vite (arg Docker) - doit pointer vers le domaine public
VITE_API_URL=https://espace-aer.nice-tek.eu

# App enregistrée dans Azure AD Epitech (tenant Epitech)
# Mettre à jour la Redirect URI dans Azure si le domaine change
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=https://espace-aer.nice-tek.eu/auth/callback

JENKINS_URL=https://jenkins.epitest.eu
JENKINS_USER=
JENKINS_TOKEN=
# Dossier d'instance Jenkins (ex : NCE-2-1) - auto-découvert si absent du chemin direct
JENKINS_INSTANCE=NCE-2-1
