# Copier en .env.prod et remplir les valeurs avant de déployer
# NE JAMAIS committer .env.prod

# Base de données
DB_PASSWORD=change_me_strong_password

# Sécurité (générer avec : openssl rand -hex 32)
JWT_SECRET=change_me_64_chars_minimum
ENCRYPTION_KEY=change_me_32_chars_exactly!!!!!!

# URLs (remplacer par ton domaine réel)
FRONTEND_URL=https://espace-aer.example.com
VITE_API_URL=https://api.espace-aer.example.com

# Microsoft OAuth (mêmes valeurs qu'en dev, redirect URI à mettre à jour dans Azure)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=https://api.espace-aer.example.com/auth/callback

# Whitelist (emails Epitech séparés par des virgules)
WHITELIST_ADMINS=ton.prenom@epitech.eu
WHITELIST_AERS=aer2@epitech.eu,aer3@epitech.eu,aer4@epitech.eu,aer5@epitech.eu
